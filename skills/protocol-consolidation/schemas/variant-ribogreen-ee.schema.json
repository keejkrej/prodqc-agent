{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodqc.example/schema/variant-ribogreen-ee.json",
  "title": "RibogreenEeVariant",
  "description": "Local structured variant. Free text only in notes. Used on every QC result and signed-off record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assay_type",
    "dye_dilution",
    "triton_standard_curve",
    "curve_well_volume_uL",
    "sample_well_volume_uL",
    "incubation_time_min",
    "incubation_temperature_C",
    "ee_formula",
    "excitation_nm",
    "emission_nm",
    "notes"
  ],
  "properties": {
    "assay_type": {
      "const": "ribogreen-ee"
    },
    "dye_dilution": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$",
      "description": "Working dye dilution as ratio, e.g. 1:100 or 1:200."
    },
    "triton_standard_curve": {
      "type": "boolean",
      "description": "True if a lysed (Triton) standard curve is described or used."
    },
    "curve_well_volume_uL": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Standard-curve well volume in microlitres."
    },
    "sample_well_volume_uL": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Sample well volume in microlitres."
    },
    "incubation_time_min": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Dye incubation time in minutes."
    },
    "incubation_temperature_C": {
      "type": "number",
      "description": "Dye incubation temperature in degrees Celsius."
    },
    "ee_formula": {
      "type": "string",
      "enum": ["1-(free/total)", "total/free", "free/total"],
      "description": "Normalised EE expression. Equivalents of 1-(free/total) include (total-free)/total."
    },
    "excitation_nm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Excitation wavelength in nanometres."
    },
    "emission_nm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Emission wavelength in nanometres."
    },
    "notes": {
      "type": "string",
      "description": "Only free-text field. Local only; strip before sharing."
    }
  }
}
