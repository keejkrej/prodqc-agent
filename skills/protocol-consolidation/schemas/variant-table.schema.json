{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodqc.example/schema/variant-table.json",
  "title": "VariantTable",
  "description": "Cross-lab export of one assay's fixed fields. Values plus source {file,line} only. No protocol text, excerpts, or notes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lab_id", "assay", "fields"],
  "properties": {
    "lab_id": {
      "type": "string",
      "minLength": 1
    },
    "assay": {
      "const": "ribogreen-ee"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dye_dilution": { "$ref": "#/$defs/stringField" },
        "triton_standard_curve": { "$ref": "#/$defs/booleanField" },
        "curve_well_volume_uL": { "$ref": "#/$defs/numberField" },
        "sample_well_volume_uL": { "$ref": "#/$defs/numberField" },
        "incubation_time_min": { "$ref": "#/$defs/numberField" },
        "incubation_temperature_C": { "$ref": "#/$defs/numberField" },
        "ee_formula": { "$ref": "#/$defs/formulaField" },
        "excitation_nm": { "$ref": "#/$defs/numberField" },
        "emission_nm": { "$ref": "#/$defs/numberField" }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Basename only. Prefer an opaque page id, not a title."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "booleanField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "numberField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "number" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "formulaField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["1-(free/total)", "total/free", "free/total"]
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
